---
import { config } from '@/config';
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="#top" class="site-header__brand">{config.siteTitle}</a>

    <nav class="site-header__nav desktop" aria-label="Primary">
      {
        config.nav.map((item) => (
          <a href={item.href} class="site-header__link">
            {item.label}
          </a>
        ))
      }
    </nav>

    <details class="mobile-menu">
      <summary>Menu</summary>
      <div class="mobile-menu__panel">
        {
          config.nav.map((item) => (
            <a href={item.href} class="mobile-menu__link">
              {item.label}
            </a>
          ))
        }
      </div>
    </details>
  </div>
</header>

<style lang="scss">
@use '../../styles/colors.scss' as *;

.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  backdrop-filter: blur(8px);
  background: rgba(6, 7, 10, 0.72);
  border-bottom: 1px solid $color-border;

  &__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0.9rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  &__brand {
    color: $color-text-primary;
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  &__nav {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  &__link {
    color: $color-text-secondary;
    text-decoration: none;
    font-size: 0.92rem;
    transition: color 0.2s ease;

    &:hover {
      color: $color-accent;
    }
  }
}

.mobile-menu {
  display: none;
  position: relative;

  summary {
    list-style: none;
    cursor: pointer;
    color: $color-text-secondary;
    border: 1px solid $color-border;
    border-radius: 10px;
    padding: 0.35rem 0.7rem;
    font-size: 0.85rem;
  }

  &__panel {
    position: absolute;
    right: 0;
    top: 2.3rem;
    min-width: 160px;
    background: $color-surface;
    border: 1px solid $color-border;
    border-radius: 12px;
    padding: 0.45rem;
    display: grid;
    gap: 0.2rem;
  }

  &__link {
    text-decoration: none;
    color: $color-text-secondary;
    padding: 0.4rem 0.55rem;
    border-radius: 8px;

    &:hover {
      background: rgba(255, 255, 255, 0.04);
      color: $color-accent;
    }
  }
}

@media (max-width: 760px) {
  .site-header__nav.desktop {
    display: none;
  }

  .mobile-menu {
    display: block;
  }
}
</style>
