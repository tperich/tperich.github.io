---
import Layout from '@/layouts/Layout.astro';
import { config } from '@/config';
import { projects } from '@/content/projects';
import { skillGroups } from '@/content/skills';
---

<Layout>
  <main id="top" class="page">
    <section class="hero">
      <p class="eyebrow">Sysadmin • Security • Automation</p>
      <h1>
        Building <span>practical tools</span> for security workflows and personal infrastructure control.
      </h1>
      <p class="lead">{config.siteDescription}</p>

      <div class="cta-row">
        <a href="#projects" class="btn btn--primary">View projects</a>
        <a href={config.links.github} class="btn" target="_blank" rel="noreferrer">GitHub</a>
      </div>

      <div class="chips">
        <span>Python</span>
        <span>TypeScript</span>
        <span>PowerShell</span>
        <span>Automation</span>
        <span>Bug Bounty</span>
      </div>
    </section>

    <section id="about" class="section">
      <h2>About</h2>
      <p>
        I focus on high-leverage systems: monitoring, remote-control reliability, bug bounty tooling, and practical
        security automation. I prefer clean execution, clear reporting, and solutions that actually hold up in real use.
      </p>
    </section>

    <section id="projects" class="section">
      <h2>Projects</h2>
      <div class="project-grid">
        {
          projects.map((p) => (
            <article class="card">
              <div class="card__top">
                <h3>{p.name}</h3>
                {p.status && <span class={`status status--${p.status}`}>{p.status}</span>}
              </div>
              <p>{p.description}</p>
              <div class="stack">
                {p.stack.map((item) => (
                  <span>{item}</span>
                ))}
              </div>
              {p.link && (
                <a href={p.link} target="_blank" rel="noreferrer" class="card__link">
                  Open project →
                </a>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <section id="skills" class="section">
      <h2>Skills</h2>
      <div class="skills-grid">
        {
          skillGroups.map((group) => (
            <article class="card">
              <h3>{group.title}</h3>
              <ul>
                {group.items.map((skill) => (
                  <li>{skill}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section id="contact" class="section section--contact">
      <h2>Contact</h2>
      <p>Open to collaboration, freelance security/dev work, and interesting automation challenges.</p>
      <div class="cta-row">
        <a href={config.links.email} class="btn btn--primary">Email me</a>
        <a href={config.links.github} class="btn" target="_blank" rel="noreferrer">GitHub</a>
      </div>
    </section>
  </main>
</Layout>

<style lang="scss">
@use '@/styles/colors.scss' as *;

.page {
  max-width: 1100px;
  margin: 0 auto;
  padding: 2rem 1.25rem 4rem;
}

.hero {
  min-height: 62vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 1.1rem;

  .eyebrow {
    color: $color-accent-soft;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.78rem;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 4.2rem);
    line-height: 1.06;
    margin: 0;
    color: $color-text-primary;

    span {
      color: $color-accent;
    }
  }

  .lead {
    max-width: 760px;
    color: $color-text-secondary;
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.6;
  }
}

.section {
  padding: 3rem 0;
  border-top: 1px solid $color-border;

  h2 {
    color: $color-text-primary;
    margin: 0 0 1rem;
    font-size: 1.5rem;
  }

  p {
    color: $color-text-secondary;
    line-height: 1.7;
  }
}

.project-grid,
.skills-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1rem;
}

.card {
  background: linear-gradient(180deg, rgba(17, 24, 39, 0.6), rgba(13, 17, 23, 0.8));
  border: 1px solid $color-border;
  border-radius: 16px;
  padding: 1rem;

  h3 {
    color: $color-text-primary;
    margin: 0 0 0.65rem;
  }

  p,
  li {
    color: $color-text-secondary;
  }

  ul {
    margin: 0;
    padding-left: 1rem;
    display: grid;
    gap: 0.35rem;
  }

  &__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  &__link {
    display: inline-block;
    margin-top: 0.8rem;
    color: $color-accent;
    text-decoration: none;
    font-size: 0.9rem;
  }
}

.status {
  font-size: 0.72rem;
  border: 1px solid $color-border;
  border-radius: 999px;
  padding: 0.2rem 0.55rem;
  color: $color-text-secondary;

  &--live {
    color: #82f0a4;
    border-color: #2f7f4a;
  }
  &--wip {
    color: #f6d676;
    border-color: #836c2b;
  }
  &--internal {
    color: #b4b7c0;
    border-color: #424855;
  }
}

.stack,
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 0.8rem;

  span {
    font-size: 0.74rem;
    color: $color-text-secondary;
    border: 1px solid $color-border;
    border-radius: 999px;
    padding: 0.26rem 0.55rem;
    background: rgba(13, 17, 23, 0.5);
  }
}

.cta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.7rem;
}

.btn {
  text-decoration: none;
  color: $color-text-primary;
  border: 1px solid $color-border;
  padding: 0.62rem 1rem;
  border-radius: 12px;
  transition: all 0.2s ease;

  &:hover {
    border-color: $color-accent;
    color: $color-accent;
  }

  &--primary {
    background: $color-accent;
    color: #041106;
    border-color: $color-accent;
    font-weight: 600;

    &:hover {
      background: #b6ff67;
      color: #041106;
    }
  }
}

.section--contact {
  margin-bottom: 1rem;
}
</style>
