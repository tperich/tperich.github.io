---
import Layout from '@/layouts/Layout.astro';
import { config } from '@/config';
import { projects } from '@/content/projects';
import { skillGroups } from '@/content/skills';
---

<Layout>
  <main id="top" class="page">
    <section class="hero">
      <div class="hero__glow" aria-hidden="true"></div>
      <p class="eyebrow">Full-Stack • DevOps • Security</p>
      <h1>
        Shipping <span>web & mobile products</span> with fast delivery, strong CI/CD, and security built into the pipeline.
      </h1>
      <p class="lead">{config.siteDescription}</p>

      <div class="cta-row">
        <a href="#projects" class="btn btn--primary">View projects</a>
        <a href={config.links.github} class="btn" target="_blank" rel="noreferrer">GitHub</a>
      </div>

      <div class="chips">
        <span>React / React Native</span>
        <span>FastAPI / Node.js</span>
        <span>CI/CD & DevOps</span>
        <span>SAST / DAST</span>
        <span>Security Engineering</span>
      </div>
    </section>

    <section id="about" class="section">
      <h2>About</h2>
      <p>
        I’m a Serbia-based engineer with hands-on experience across product delivery, DevOps, and security.
        I’ve led mobile development from zero to app-store release, built CI/CD pipelines used across teams,
        and integrated security gates (SAST/DAST) into delivery flows without slowing shipping velocity.
      </p>
    </section>

    <section id="projects" class="section">
      <h2>Projects</h2>
      <div class="project-grid">
        {
          projects.map((p) => (
            <article class="card">
              <div class="card__top">
                <h3>{p.name}</h3>
                {p.status && <span class={`status status--${p.status}`}>{p.status}</span>}
              </div>
              <p>{p.description}</p>
              <div class="stack">
                {p.stack.map((item) => (
                  <span>{item}</span>
                ))}
              </div>
              {p.link && (
                <a href={p.link} target="_blank" rel="noreferrer" class="card__link">
                  Open project →
                </a>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <section id="skills" class="section">
      <h2>Skills</h2>
      <div class="skills-grid">
        {
          skillGroups.map((group) => (
            <article class="card">
              <h3>{group.title}</h3>
              <ul>
                {group.items.map((skill) => (
                  <li>{skill}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section id="contact" class="section section--contact">
      <h2>Contact</h2>
      <p>
        Open to product engineering, DevOps/SRE, and security-focused roles. If you're building fast and want
        reliability + security done pragmatically, let’s talk.
      </p>
      <div class="cta-row">
        <a href={config.links.email} class="btn btn--primary">tomislavperich@protonmail.com</a>
        <a href={config.links.github} class="btn" target="_blank" rel="noreferrer">GitHub</a>
        <a href={config.links.linkedin} class="btn" target="_blank" rel="noreferrer">LinkedIn</a>
      </div>
    </section>
  </main>
</Layout>

<style lang="scss">
@use '@/styles/colors.scss' as *;

.page {
  max-width: 1120px;
  margin: 0 auto;
  padding: 2.2rem 1.25rem 5rem;
}

.hero {
  position: relative;
  overflow: hidden;
  border: 1px solid $color-border;
  border-radius: 24px;
  background: radial-gradient(circle at 78% 10%, rgba(163, 255, 63, 0.16), transparent 40%),
    linear-gradient(180deg, rgba(17, 24, 39, 0.62), rgba(13, 17, 23, 0.84));
  min-height: 66vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 1.1rem;
  padding: clamp(1.4rem, 3.5vw, 3rem);
  animation: fadeUp 0.6s ease both;

  &__glow {
    position: absolute;
    right: -120px;
    top: -120px;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    filter: blur(36px);
    background: radial-gradient(circle, rgba(125, 255, 179, 0.24), rgba(125, 255, 179, 0));
    pointer-events: none;
  }

  .eyebrow {
    color: $color-accent-soft;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-size: 0.76rem;
    position: relative;
    z-index: 1;
  }

  h1 {
    font-size: clamp(2.05rem, 6vw, 4.35rem);
    line-height: 1.04;
    margin: 0;
    color: $color-text-primary;
    max-width: 15ch;
    position: relative;
    z-index: 1;

    span {
      color: $color-accent;
    }
  }

  .lead {
    max-width: 760px;
    color: #b6bdc9;
    font-size: clamp(1rem, 2vw, 1.16rem);
    line-height: 1.65;
    position: relative;
    z-index: 1;
  }
}

.section {
  padding: 3.2rem 0;
  border-top: 1px solid $color-border;
  animation: fadeUp 0.7s ease both;

  h2 {
    color: $color-text-primary;
    margin: 0 0 1rem;
    font-size: clamp(1.4rem, 2.4vw, 1.8rem);
    letter-spacing: -0.01em;
  }

  p {
    color: #aab2bf;
    line-height: 1.75;
    max-width: 850px;
  }
}

.project-grid,
.skills-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1rem;
}

.card {
  background: linear-gradient(180deg, rgba(17, 24, 39, 0.72), rgba(13, 17, 23, 0.9));
  border: 1px solid $color-border;
  border-radius: 18px;
  padding: 1.05rem;
  box-shadow: 0 8px 28px rgba(0, 0, 0, 0.26);
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;

  &:hover {
    transform: translateY(-2px);
    border-color: rgba(163, 255, 63, 0.35);
    box-shadow: 0 10px 36px rgba(0, 0, 0, 0.3);
  }

  h3 {
    color: $color-text-primary;
    margin: 0 0 0.65rem;
  }

  p,
  li {
    color: #a7b0bd;
  }

  ul {
    margin: 0;
    padding-left: 1rem;
    display: grid;
    gap: 0.35rem;
  }

  &__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  &__link {
    display: inline-block;
    margin-top: 0.8rem;
    color: $color-accent;
    text-decoration: none;
    font-size: 0.9rem;

    &:hover {
      color: #c4ff8f;
    }
  }
}

.status {
  font-size: 0.72rem;
  border: 1px solid $color-border;
  border-radius: 999px;
  padding: 0.2rem 0.55rem;
  color: $color-text-secondary;

  &--live {
    color: #82f0a4;
    border-color: #2f7f4a;
  }
  &--wip {
    color: #f6d676;
    border-color: #836c2b;
  }
  &--internal {
    color: #b4b7c0;
    border-color: #424855;
  }
}

.stack,
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 0.8rem;

  span {
    font-size: 0.74rem;
    color: $color-text-secondary;
    border: 1px solid $color-border;
    border-radius: 999px;
    padding: 0.26rem 0.55rem;
    background: rgba(13, 17, 23, 0.5);
  }
}

.cta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.7rem;
}

.btn {
  text-decoration: none;
  color: $color-text-primary;
  border: 1px solid $color-border;
  padding: 0.62rem 1rem;
  border-radius: 12px;
  transition: all 0.2s ease;
  background: rgba(255, 255, 255, 0.02);

  &:hover {
    border-color: $color-accent;
    color: $color-accent;
    background: rgba(163, 255, 63, 0.06);
  }

  &--primary {
    background: linear-gradient(90deg, #a3ff3f, #91ff7f);
    color: #041106;
    border-color: transparent;
    font-weight: 700;

    &:hover {
      background: linear-gradient(90deg, #b6ff67, #9eff8f);
      color: #041106;
    }
  }
}

.section--contact {
  margin-bottom: 1rem;
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 760px) {
  .page {
    padding: 1rem 0.95rem 3rem;
  }

  .hero {
    min-height: auto;
    border-radius: 18px;
    padding: 1.1rem;

    h1 {
      max-width: none;
    }
  }

  .cta-row {
    width: 100%;

    .btn {
      flex: 1;
      text-align: center;
    }
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero,
  .section {
    animation: none;
  }

  .card {
    transition: none;
  }
}
</style>
